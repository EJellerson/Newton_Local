# ---------------------------------------------------------------------------
# Newton_Local — repository hygiene
#
# Rule of thumb: anything large, generated, secret, or reproducible from a
# pinned identity stays out of git. Manifests and documentation stay in.
# ---------------------------------------------------------------------------

# --- Model weights -----------------------------------------------------
# Never commit weights. models/ itself IS tracked so that manifests and
# documentation beside the weights remain versionable.
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# --- External / reproducible tool trees ---------------------------------
# tools/llama.cpp is an upstream git clone (338 MB, nested .git). It is
# fully reproducible from the commit pinned in docs/01-llamacpp.md via
# scripts/build-llamacpp.sh.
tools/llama.cpp/
# tools/hf-venv is a Python virtualenv (32 MB), recreated on demand.
tools/hf-venv/
build/

# --- Credentials and caches ---------------------------------------------
# Defence in depth: HF tokens live in ~/.cache/huggingface, outside this
# tree, but never let one land here by accident.
**/token
**/tokens
.hf_token
*.pem
*.key
.env
.env.*
!config/qwen-a.env
.cache/
**/.cache/
hf-cache/

# --- Local model download sources ---------------------------------------
# Where each model's weights come from (repository, pinned revision,
# upstream file names) is machine-local; the tracked template is
# config/model-sources.example.json.
config/model-sources.local.json

# --- Runtime state and logs ---------------------------------------------
logs/
state/
*.log
*.pid

# --- Assistant runtime state (Commission #3) -----------------------------
# Hermes and Open WebUI keep everything private under $HOME, outside this
# tree. These rules are defence in depth, for the day someone copies or
# symlinks a profile in here "just to look at it".
.hermes/
**/.hermes/
.open-webui/
**/.open-webui/
hermes-agent/
*.db
*.sqlite
*.sqlite3
memories/MEMORY.md
memories/USER.md
SOUL.md
# Rendered LaunchAgent plists embed the API bearer key; only templates ship.
config/com.newton.openwebui.plist
!config/*.plist.template

# --- macOS noise ---------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- Commission #5: Flash-Next pack + pinned mlx-serve engine --------------
# The 100 GiB MLX-Serve pack: everything but its provenance manifests stays out.
models/qwen38-flash-next-mlx-4bit/*
!models/qwen38-flash-next-mlx-4bit/MANIFEST.md
!models/qwen38-flash-next-mlx-4bit/MANIFEST.json
# Machine-readable manifest for the 27B pack is tracked (small JSON).
# The engine binary release (pinned + hash-verified by install-mlx-serve.sh).
tools/mlx-serve/

# --- Fish speech service (docs/18) ----------------------------------------
# The 24 GiB Drama 3 MLX Q4 pack: only its provenance manifests are tracked.
models/fish-drama3-mlx-q4/*
!models/fish-drama3-mlx-q4/MANIFEST.md
!models/fish-drama3-mlx-q4/MANIFEST.json
# The isolated runtime and its pinned source checkout, rebuilt by
# scripts/install-fish-runtime.sh. No trailing slash: these may be symlinks.
tools/fish-venv
tools/fish-src
# Private voice data lives outside the repository (config/fish.json
# service.store). Defence in depth, should anyone copy recordings in here.
*.wav
*.flac
*.m4a
*.mp3
*.ogg
*.opus
*.webm
*.aiff
*.caf
# A voice store copied into the tree (its layout), never the page's code.
voice-studio/
!scripts/voice-studio/
