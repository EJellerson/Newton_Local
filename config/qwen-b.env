# Newton_Local — Qwen-B canonical runtime configuration.
#
# Qwen-B is the ELASTIC WORKER: normally stopped, started on demand by the
# controller (scripts/qwenctl.py), stopped again after an idle grace period.
#
# SINGLE SOURCE OF TRUTH FOR SHARED ARTIFACTS
# -------------------------------------------
# The model, mmproj, llama-server binary and context size are NOT restated
# here. They are inherited verbatim by sourcing Qwen-A's frozen definition,
# so there is exactly one place on disk where the canonical Q8_0 GGUF path
# lives. Qwen-A's file is never modified by Commission #2.
#
#   NEWTON_ROOT, LLAMA_BIN, MODEL, MMPROJ, CTX  <- inherited from qwen-a.env
#
# Only the fields that MUST differ between the two instances are set below.
. /Users/ericjellerson/Newton_Local/config/qwen-a.env

ALIAS=qwen-b
HOST=127.0.0.1
PORT=8081

# Elastic-worker lifecycle parameters (consumed by scripts/qwenctl.py).
QWEN_B_LABEL=com.newton.qwen38server.b
QWEN_B_DOMAIN=gui
QWEN_B_LOGDIR=/Users/ericjellerson/Newton_Local/logs/qwen-b
QWEN_B_LEASE=/Users/ericjellerson/Newton_Local/state/qwen-b-lease.json
QWEN_B_LOCK=/Users/ericjellerson/Newton_Local/state/qwen-b.lock
# Idle grace period before an IDLE worker is terminated, in seconds.
QWEN_B_IDLE_TTL=180
# Hard ceiling on how long acquire() waits for /health to go green.
QWEN_B_START_TIMEOUT=240
# A BUSY lease whose heartbeat is older than this is treated as abandoned.
QWEN_B_LEASE_MAX_AGE=1800
