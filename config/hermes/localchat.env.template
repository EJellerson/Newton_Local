# ---------------------------------------------------------------------------
# Template for ~/.hermes/profiles/localchat/.env   (Commission #3)
#
# THE REAL FILE IS NEVER COMMITTED. It lives only at
#   ~/.hermes/profiles/localchat/.env      mode 0600
# and holds the one secret this stack has: the API-server bearer key.
#
# Generate a key and write the real file with:
#
#   KEY="hermes-localchat-$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')"
#   printf 'API_SERVER_ENABLED=true\nAPI_SERVER_KEY=%s\nAPI_SERVER_HOST=127.0.0.1\nAPI_SERVER_PORT=8642\n' \
#     "$KEY" >> ~/.hermes/profiles/localchat/.env
#   chmod 600 ~/.hermes/profiles/localchat/.env
#
# Then re-run scripts/install-openwebui.sh so the frontend picks up the new key.
#
# NOTE: behavioural settings belong in config.yaml, not here. This file is for
# credentials. In Hermes v0.20.5 the API server is configured by BOTH
# platforms.api_server.* in config.yaml AND these env vars; the key must come
# from the env (a key shorter than 16 chars is rejected and the listener
# refuses to start).
# ---------------------------------------------------------------------------

# Terminal backend selector consumed by Hermes (written by `hermes profile create`).
TERMINAL_ENV=local

# --- Hermes API server: the door Open WebUI knocks on ----------------------
API_SERVER_ENABLED=true
API_SERVER_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642

# Leave CORS off unless a browser app on another origin must call the API
# directly. Open WebUI proxies server-side, so it does not need this.
# API_SERVER_CORS_ORIGINS=http://127.0.0.1:3000

# --- Deliberately absent ---------------------------------------------------
# No OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY,
# NOUS_API_KEY or any other cloud-LLM credential. The assistant's intelligence
# is Qwen-A on 127.0.0.1:8080 and nothing else; fallback_providers is empty so
# a Qwen-A outage surfaces as an error instead of a silent cloud call.
# Web search needs no key either — Hermes rotates public free tiers.
