<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.newton.qwen38server.a</string>

    <!-- Least privilege: a system LaunchDaemon starts at boot without an
         interactive login, but the inference process itself runs as the
         owning user, never as root. -->
    <key>UserName</key>
    <string>ericjellerson</string>
    <key>GroupName</key>
    <string>staff</string>

    <!-- Absolute paths only. No shell, no login profile, no PATH lookup. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ericjellerson/Newton_Local/tools/llama.cpp/build/bin/llama-server</string>
        <string>--model</string>
        <string>/Users/ericjellerson/Newton_Local/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf</string>
        <string>--mmproj</string>
        <string>/Users/ericjellerson/Newton_Local/models/qwen38-27b/mmproj-Qwen3.8-27B-f16.gguf</string>
        <string>--alias</string>
        <string>qwen-a</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>
        <string>--ctx-size</string>
        <string>262144</string>
        <string>--n-gpu-layers</string>
        <string>999</string>
        <string>--flash-attn</string>
        <string>on</string>
        <string>--jinja</string>
        <string>--parallel</string>
        <string>1</string>
        <string>--cont-batching</string>
        <string>--metrics</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ericjellerson/Newton_Local</string>

    <!-- Explicit, minimal environment. Nothing is inherited from a shell. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/ericjellerson</string>
        <key>TMPDIR</key>
        <string>/tmp</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Avoid the background CPU/IO throttling applied to Standard daemons;
         this is a latency-sensitive inference service. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/ericjellerson/Newton_Local/logs/qwen-a/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ericjellerson/Newton_Local/logs/qwen-a/stderr.log</string>
</dict>
</plist>
