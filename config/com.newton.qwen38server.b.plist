<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Newton_Local — Qwen-B elastic worker (Commission #2).

  DOMAIN
    User LaunchAgent, bootstrapped into gui/<uid>. Deliberately NOT a system
    LaunchDaemon: the elastic-worker controller must be able to start and stop
    this job without sudo, and without any passwordless-root grant. Qwen-A's
    root LaunchDaemon on :8080 is untouched by this file.

  ON-DEMAND SEMANTICS
    RunAtLoad = false  -> bootstrapping registers the job but does not run it.
    KeepAlive = false  -> once stopped it STAYS stopped; launchd never respawns.
    The job is therefore "registered but absent": zero model RAM when idle.
    Start:  launchctl kickstart  gui/<uid>/com.newton.qwen38server.b
    Stop:   launchctl kill TERM  gui/<uid>/com.newton.qwen38server.b

  ARGUMENT VECTOR (Commission #5: execution slot, not a fixed model)
    The job runs the slot shim `newton_models.py exec-slot B`, which resolves
    the GLOBAL model selection at spawn time, refuses if that model is not
    installed/intact/runnable, and execv()s the registry's runtime + argv on
    this slot's port (8081). scripts/qwen-b-argv.sh remains the frozen
    llama.cpp argv for Qwen 27B on this slot; install-launchagent-b.sh checks
    that the registry's Qwen-27B plan for slot B still equals it token for
    token, and that this plist runs exactly `newton-model shim-argv B`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.newton.qwen38server.b</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/ericjellerson/Newton_Local/scripts/newton_models.py</string>
        <string>exec-slot</string>
        <string>B</string>
    </array>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/ericjellerson/Newton_Local</string>

    <key>StandardOutPath</key>
    <string>/Users/ericjellerson/Newton_Local/logs/qwen-b/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ericjellerson/Newton_Local/logs/qwen-b/stderr.log</string>

    <!-- Absolute PATH only. The job must never depend on shell startup files. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Match Qwen-A: no ProcessType override, so both instances receive the
         same "Standard" scheduling class and the A-vs-A+B comparison is fair. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
</dict>
</plist>
