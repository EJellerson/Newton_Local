<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Newton AI Control — the loopback control-plane service (Commission #4).

  Rendered by scripts/install-control.sh (substitutes __NEWTON_ROOT__) into
  ~/Library/LaunchAgents/com.newton.control.plist.

  Always-on infrastructure, like Hermes and Open WebUI: RunAtLoad+KeepAlive
  in the gui domain, so the control panel is available at every login. It
  binds 127.0.0.1:8765 only and NEVER starts the model on its own — the
  desired-state file it consults is written exclusively by explicit operator
  Start/Stop actions and is invalidated by every reboot.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.newton.control</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__NEWTON_ROOT__/scripts/newton_control.py</string>
        <string>--port</string>
        <string>8765</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- A crash-looping panel must not hammer launchd. -->
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>WorkingDirectory</key>
    <string>__NEWTON_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__NEWTON_ROOT__/logs/control/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__NEWTON_ROOT__/logs/control/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
