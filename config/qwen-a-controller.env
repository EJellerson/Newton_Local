# Newton_Local — controller configuration for the CANONICAL production Qwen (A).
#
# Commission #4: Qwen-A moves from an always-on root LaunchDaemon to an
# ON-DEMAND user LaunchAgent (gui/<uid>) driven by scripts/qwenctl.py and the
# Newton AI Control panel. The runtime identity — binary, weights, mmproj,
# alias qwen-a, 127.0.0.1:8080, ctx 262144 — is inherited unchanged from
# qwen-a.env, the single source of truth, exactly the way qwen-b.env does.
. "$(dirname "${BASH_SOURCE[0]}")/qwen-a.env"

# Controller identity (generic CTL_* keys; see scripts/qwenctl.py load_config).
CTL_INSTANCE=qwen-a
CTL_LABEL=com.newton.qwen38server.a
CTL_DOMAIN=gui
CTL_LOGDIR=$NEWTON_ROOT/logs/qwen-a
CTL_LEASE=$NEWTON_ROOT/state/qwen-a-lease.json
CTL_LOCK=$NEWTON_ROOT/state/qwen-a.lock

# 0 DISABLES the idle TTL: the production instance runs until explicitly
# stopped (Newton AI Control "Stop the AI Model", or `qwen-a terminate`).
# No reaper ever collects it; `reap` is a hard no-op at TTL<=0.
CTL_IDLE_TTL=0

# The first start after a reboot faults ~27 GiB of weights in from disk, so
# the readiness ceiling is more generous than Qwen-B's warm-cache 240 s.
CTL_START_TIMEOUT=300

# Only meaningful if a lease is ever taken via `acquire` (the production
# panel never does); kept for controller completeness.
CTL_LEASE_MAX_AGE=1800

# Execution-slot identity for the model registry (Commission #5).
CTL_SLOT=A
